{
  "name": "kstrl",
  "productName": "KSTRL",
  "version": "1.3.0",
  "description": "KSTRL \u2014 the AI coding environment powered by the Colossus models.",
  "author": "KSTRL",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env KSTRL_DEV=1 electron .\"",
    "build": "vite build",
    "start": "npm run build && electron .",
    "icons": "node scripts/make-icons.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "dist:win:portable": "npm run build && electron-builder --win portable --x64",
    "release:win": "npm run build && electron-builder --win --x64 --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "dompurify": "^3.5.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.81.0",
    "marked": "^18.3.0",
    "monaco-editor": "^0.58.0",
    "png-to-ico": "^2.1.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.34.0",
    "vite": "^8.4.0",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "ai.kstrl.app",
    "productName": "KSTRL",
    "copyright": "Copyright \u00a9 2026 KSTRL",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!node_modules/node-pty/build/**",
      "!node_modules/node-pty/deps/**",
      "!node_modules/node-pty/src/**",
      "!node_modules/node-pty/prebuilds/darwin-*/**",
      "!node_modules/node-pty/prebuilds/win32-arm64/**",
      "!node_modules/node-pty/third_party/conpty/*/win10-arm64/**"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KSTRL",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "KSTRL-Setup-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/node-pty/**"
    ],
    "npmRebuild": false,
    "portable": {
      "artifactName": "KSTRL-${version}-Portable.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AmirFoodDelivery",
        "repo": "KSTRL",
        "releaseType": "release"
      }
    ]
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  }
}
